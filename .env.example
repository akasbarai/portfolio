# GEMINI_API_KEY: Optional for local browsing, required for Gemini AI helpers.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"
PORT=3000
HMR_PORT=24678

# OWNER_PORTAL_PASSWORD: The administrative passcode used to access Akash's Portal.
# Required. There is no hardcoded fallback password.
OWNER_PORTAL_PASSWORD="YOUR_STRONG_PORTAL_PASSWORD_HERE"

# SESSION_SECRET: Required for signed owner and astrology session tokens.
# Use at least 32 random characters.
SESSION_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# EMAIL CONFIGURATION FOR ASTROLOGER PORTAL
# To send real email notifications, configure your SMTP server below:
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER=""
EMAIL_PASS=""
